#!/usr/bin/env bash
set -euo pipefail

# Cometen IRL System - ROCK 5B+ external Noctua PWM fan controller v2.3
#
# Hardware:
#   ROCK 5B+ GPIO pin 3 -> PWM15-M1 -> Noctua blue PWM wire
#   GPIO pin 4          -> +5V       -> Noctua yellow wire
#   GPIO pin 5          -> TACH      -> Noctua green wire (RPM support later)
#   GPIO pin 6          -> GND       -> Noctua black wire
#
# Uses PWM15 device febf0030.pwm.
# PWM frequency: 25 kHz (period 40000 ns).
#
# Temperature sources:
#   1. ROCK 5B+ SoC temperature
#   2. BME280 enclosure temperature from /run/cometen/bme280.json
#
# Highest requested fan speed always wins.
#
# CPU rise curve:
#   < 42 C   -> 20 %
#   42-49 C  -> 30 %
#   50-56 C  -> 45 %
#   57-64 C  -> 70 %
#   >= 65 C  -> 100 %
#
# CPU fall thresholds (hysteresis):
#   45 -> 30 only at <= 48 C
#   30 -> 20 only at <= 40 C
#   70 -> 45 only at <= 55 C
#   100 -> 70 only at <= 62 C
#
# Enclosure/BME280 rise curve:
#   < 32 C   -> 20 %
#   32-35 C  -> 30 %
#   36-39 C  -> 45 %
#   40-43 C  -> 70 %
#   >= 44 C  -> 100 %
#
# Enclosure fall thresholds:
#   30 -> 20 at <= 30 C
#   45 -> 30 at <= 34 C
#   70 -> 45 at <= 38 C
#   100 -> 70 at <= 42 C
#
# Fan speed increases immediately. A requested decrease must remain valid for
# 30 seconds before PWM is lowered. Combined with hysteresis this prevents the
# fan from bouncing between 30/45 % when the SoC sits around 49-50 C.
#
# If BME280 data disappears or becomes stale, CPU control continues normally.
# If this controller exits, fan fails safe to 100 %.

TEMP_FILE="/sys/class/thermal/thermal_zone0/temp"
BME_JSON="/run/cometen/bme280.json"
BME_MAX_AGE=15

PWM_DEVICE_MATCH="febf0030.pwm"
PWM_CHANNEL=0
PWM_PERIOD_NS=40000
POLL_SECONDS=2
DOWN_DELAY_SECONDS=30

find_pwmchip() {
    local chip
    for chip in /sys/class/pwm/pwmchip*; do
        [[ -e "$chip" ]] || continue
        if readlink -f "$chip/device" | grep -q "$PWM_DEVICE_MATCH"; then
            echo "$chip"
            return 0
        fi
    done
    return 1
}

read_pwm_int() {
    local file="$1"
    local value
    value="$(cat "$file" 2>/dev/null || echo 0)"
    [[ "$value" =~ ^[0-9]+$ ]] || value=0
    echo "$value"
}

prepare_pwm_disabled() {
    local current_period current_duty

    if [[ "$(read_pwm_int "$PWM_PATH/enable")" != "0" ]]; then
        echo 0 > "$PWM_PATH/enable"
    fi

    current_period="$(read_pwm_int "$PWM_PATH/period")"
    current_duty="$(read_pwm_int "$PWM_PATH/duty_cycle")"

    if (( current_period <= 0 )); then
        echo "$PWM_PERIOD_NS" > "$PWM_PATH/period"
    elif (( current_period != PWM_PERIOD_NS )); then
        if (( current_duty > PWM_PERIOD_NS )); then
            echo 0 > "$PWM_PATH/duty_cycle"
        fi
        echo "$PWM_PERIOD_NS" > "$PWM_PATH/period"
    fi

    echo 0 > "$PWM_PATH/duty_cycle"

    if [[ -w "$PWM_PATH/polarity" ]]; then
        echo normal > "$PWM_PATH/polarity"
    fi
}

set_duty_percent() {
    local percent="$1"
    local duty=$(( PWM_PERIOD_NS * percent / 100 ))
    echo "$duty" > "$PWM_PATH/duty_cycle"
}

failsafe_full_speed() {
    [[ -n "${PWM_PATH:-}" && -d "${PWM_PATH:-}" ]] || return 0

    set +e

    echo 0 > "$PWM_PATH/enable" 2>/dev/null

    local current_period current_duty
    current_period="$(read_pwm_int "$PWM_PATH/period")"
    current_duty="$(read_pwm_int "$PWM_PATH/duty_cycle")"

    if (( current_period <= 0 )); then
        echo "$PWM_PERIOD_NS" > "$PWM_PATH/period" 2>/dev/null
    elif (( current_period != PWM_PERIOD_NS )); then
        if (( current_duty > PWM_PERIOD_NS )); then
            echo 0 > "$PWM_PATH/duty_cycle" 2>/dev/null
        fi
        echo "$PWM_PERIOD_NS" > "$PWM_PATH/period" 2>/dev/null
    fi

    echo "$PWM_PERIOD_NS" > "$PWM_PATH/duty_cycle" 2>/dev/null
    echo 1 > "$PWM_PATH/enable" 2>/dev/null
}

cpu_rise_percent() {
    local t="$1"
    if (( t >= 65 )); then
        echo 100
    elif (( t >= 57 )); then
        echo 70
    elif (( t >= 50 )); then
        echo 45
    elif (( t >= 42 )); then
        echo 30
    else
        echo 20
    fi
}

cpu_fall_percent() {
    local t="$1"
    if (( t >= 63 )); then
        echo 100
    elif (( t >= 56 )); then
        echo 70
    elif (( t >= 49 )); then
        echo 45
    elif (( t >= 41 )); then
        echo 30
    else
        echo 20
    fi
}

case_rise_percent() {
    local t="$1"
    if (( t >= 44 )); then
        echo 100
    elif (( t >= 40 )); then
        echo 70
    elif (( t >= 36 )); then
        echo 45
    elif (( t >= 32 )); then
        echo 30
    else
        echo 20
    fi
}

case_fall_percent() {
    local t="$1"
    if (( t >= 43 )); then
        echo 100
    elif (( t >= 39 )); then
        echo 70
    elif (( t >= 35 )); then
        echo 45
    elif (( t >= 31 )); then
        echo 30
    else
        echo 20
    fi
}

hysteresis_percent() {
    local current="$1"
    local rise="$2"
    local fall="$3"

    if (( current < 0 )); then
        echo "$rise"
    elif (( rise > current )); then
        echo "$rise"
    elif (( fall < current )); then
        echo "$fall"
    else
        echo "$current"
    fi
}

read_case_temp() {
    [[ -r "$BME_JSON" ]] || return 1

    local now mtime age
    now="$(date +%s)"
    mtime="$(stat -c %Y "$BME_JSON" 2>/dev/null)" || return 1
    age=$(( now - mtime ))
    (( age <= BME_MAX_AGE )) || return 1

    python3 - "$BME_JSON" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        data = json.load(handle)
    print(round(float(data["temperature_c"])))
except Exception:
    sys.exit(1)
PY
}

[[ -r "$TEMP_FILE" ]] || {
    echo "Temperature source missing: $TEMP_FILE" >&2
    exit 1
}

PWM_CHIP="$(find_pwmchip)" || {
    echo "PWM15 controller ($PWM_DEVICE_MATCH) not found." >&2
    exit 1
}

PWM_PATH="$PWM_CHIP/pwm${PWM_CHANNEL}"

if [[ ! -d "$PWM_PATH" ]]; then
    echo "$PWM_CHANNEL" > "$PWM_CHIP/export"
    for _ in {1..20}; do
        [[ -d "$PWM_PATH" ]] && break
        sleep 0.1
    done
fi

[[ -d "$PWM_PATH" ]] || {
    echo "Could not export $PWM_PATH" >&2
    exit 1
}

trap failsafe_full_speed EXIT INT TERM

prepare_pwm_disabled

# Start at full speed until the first temperature reading is processed.
echo "$PWM_PERIOD_NS" > "$PWM_PATH/duty_cycle"
echo 1 > "$PWM_PATH/enable"

logger -t cometen-fan \
    "PWM fan controller v2.3 started: CPU+BME280 dual control with hysteresis"

last_percent=-1
cpu_state=-1
case_state=-1
down_since=0
last_status=""

while true; do
    raw_temp="$(cat "$TEMP_FILE")"
    cpu_temp=$(( raw_temp / 1000 ))

    cpu_rise="$(cpu_rise_percent "$cpu_temp")"
    cpu_fall="$(cpu_fall_percent "$cpu_temp")"
    cpu_state="$(hysteresis_percent "$cpu_state" "$cpu_rise" "$cpu_fall")"

    case_temp=""
    case_pwm=0
    case_temp="$(read_case_temp 2>/dev/null || true)"

    if [[ "$case_temp" =~ ^-?[0-9]+$ ]]; then
        case_rise="$(case_rise_percent "$case_temp")"
        case_fall="$(case_fall_percent "$case_temp")"
        case_state="$(hysteresis_percent "$case_state" "$case_rise" "$case_fall")"
        case_pwm="$case_state"
    else
        # BME280 is supplemental. On stale/missing data, fall back to CPU only.
        case_state=-1
        case_pwm=0
    fi

    target_pwm="$cpu_state"
    if (( case_pwm > target_pwm )); then
        target_pwm="$case_pwm"
    fi

    now="$(date +%s)"

    if (( last_percent < 0 )); then
        set_duty_percent "$target_pwm"
        last_percent="$target_pwm"
        down_since=0
    elif (( target_pwm > last_percent )); then
        # Temperature rises are acted on immediately.
        set_duty_percent "$target_pwm"
        last_percent="$target_pwm"
        down_since=0
    elif (( target_pwm < last_percent )); then
        # Lower speed only if the lower requirement remains valid long enough.
        if (( down_since == 0 )); then
            down_since="$now"
        elif (( now - down_since >= DOWN_DELAY_SECONDS )); then
            set_duty_percent "$target_pwm"
            last_percent="$target_pwm"
            down_since=0
        fi
    else
        down_since=0
    fi

    if [[ "$case_temp" =~ ^-?[0-9]+$ ]]; then
        status="cpu=${cpu_temp}C cpu_req=${cpu_state}% case=${case_temp}C case_req=${case_pwm}% pwm=${last_percent}%"
    else
        status="cpu=${cpu_temp}C cpu_req=${cpu_state}% case=unavailable pwm=${last_percent}%"
    fi

    if [[ "$status" != "$last_status" ]]; then
        logger -t cometen-fan "$status"
        last_status="$status"
    fi

    sleep "$POLL_SECONDS"
done
